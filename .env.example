# Copy this file to .env and replace the placeholders. Never commit .env.
# Dev nhanh: để trống DATABASE_URL -> app dùng PostgreSQL in-memory (mất dữ liệu khi restart).
# Khi dùng PostgreSQL thật, cần cả SESSION_SECRET.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://shoe:REPLACE_ME@localhost:5432/shoe
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Tài khoản admin (chỉ dùng khi chạy với PostgreSQL thật; dev in-memory tự seed admin ngẫu nhiên).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_ME
